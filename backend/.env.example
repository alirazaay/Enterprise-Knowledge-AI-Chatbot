APP_ENV=development
APP_NAME=enterprise-knowledge-ai
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://enterprise_ai:change-me@localhost:5432/enterprise_knowledge_ai
POSTGRES_DB=enterprise_knowledge_ai
POSTGRES_USER=enterprise_ai
POSTGRES_PASSWORD=change-me
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=100
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25
